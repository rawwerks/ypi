#!/bin/bash
# Pre-commit hook for ypi
# Safety net for direct Git usage.
#
# Install: git config core.hooksPath .githooks

# --- Gitleaks: scan staged changes for secrets ---
if command -v gitleaks &>/dev/null; then
    gitleaks protect --staged --no-banner
    if [ $? -ne 0 ]; then
        echo "⛔ gitleaks detected secrets in staged files!" >&2
        echo "Fix the leak or add to .gitleaksignore if it's a false positive." >&2
        exit 1
    fi
else
    echo "⚠️  gitleaks not installed — skipping secret scan" >&2
fi

# --- UBS: scan staged code for likely bugs (scoped + fast; skip with YPI_SKIP_UBS=1) ---
if [ "${YPI_SKIP_UBS:-0}" != "1" ] && command -v ubs &>/dev/null; then
    UBS_FILES=$(git diff --cached --name-only --diff-filter=ACM \
        | grep -E '\.(ts|tsx|js|jsx|py|rs|go|java|rb|swift|cs|ex|exs)$' || true)
    if [ -n "$UBS_FILES" ]; then
        if ! ubs $UBS_FILES; then
            echo "⛔ ubs flagged likely bugs in staged files (set YPI_SKIP_UBS=1 to override)." >&2
            exit 1
        fi
    fi
fi

exit 0
