#!/usr/bin/env python3
"""List and render direct-child Pi JSONL sessions without following links."""

from __future__ import annotations

import json
import os
import re
import stat
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Iterator, NoReturn


def fail(message: str, code: int = 1) -> NoReturn:
    print(message, file=sys.stderr)
    raise SystemExit(code)


if os.environ.get("RLM_SHARED_SESSIONS", "1") == "0":
    print("Session sharing disabled (RLM_SHARED_SESSIONS=0).", file=sys.stderr)
    raise SystemExit(0)

raw_session_dir = os.environ.get("RLM_SESSION_DIR", "")
if not raw_session_dir:
    fail("No session directory found.\n  RLM_SESSION_DIR=<not set>")

session_dir = Path(raw_session_dir).absolute()
try:
    directory_lstat = session_dir.lstat()
    resolved = session_dir.resolve(strict=True)
except OSError as error:
    fail(f"No session directory found: {error}")
if not stat.S_ISDIR(directory_lstat.st_mode) or resolved != session_dir:
    fail(f"Session directory must be a regular non-symlink path: {session_dir}")
if hasattr(os, "getuid") and directory_lstat.st_uid != os.getuid():
    fail(f"Session directory must be owned by the current uid: {session_dir}")
if os.name != "nt" and stat.S_IMODE(directory_lstat.st_mode) != 0o700:
    fail(f"Session directory must have mode 0700: {session_dir}")

directory_flags = (
    os.O_RDONLY
    | getattr(os, "O_DIRECTORY", 0)
    | getattr(os, "O_NOFOLLOW", 0)
)
try:
    directory_fd = os.open(session_dir, directory_flags)
except OSError as error:
    fail(f"Cannot open session directory: {error}")
directory_stat = os.fstat(directory_fd)
if (
    not stat.S_ISDIR(directory_stat.st_mode)
    or directory_stat.st_dev != directory_lstat.st_dev
    or directory_stat.st_ino != directory_lstat.st_ino
):
    os.close(directory_fd)
    fail(f"Session directory identity changed during validation: {session_dir}")

trace_id = re.sub(
    r"[^a-zA-Z0-9._-]",
    "_",
    os.environ.get("RLM_TRACE_ID", ""),
)


@dataclass(frozen=True)
class SessionEntry:
    name: str
    size: int
    mtime_ns: int


def session_entries(trace_only: bool = False) -> list[SessionEntry]:
    entries: list[SessionEntry] = []
    with os.scandir(directory_fd) as iterator:
        for entry in iterator:
            if not entry.name.endswith(".jsonl"):
                continue
            if trace_only and trace_id and not entry.name.startswith(trace_id):
                continue
            metadata = entry.stat(follow_symlinks=False)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_nlink != 1
                or (
                    hasattr(os, "getuid")
                    and metadata.st_uid != os.getuid()
                )
                or (
                    os.name != "nt"
                    and stat.S_IMODE(metadata.st_mode) != 0o600
                )
            ):
                fail(
                    "Session entries must be private, singly-linked regular "
                    f"files: {json.dumps(entry.name)}"
                )
            entries.append(
                SessionEntry(
                    name=entry.name,
                    size=metadata.st_size,
                    mtime_ns=metadata.st_mtime_ns,
                )
            )
    return sorted(entries, key=lambda item: item.name)


def checked_name(value: str) -> str:
    if (
        not value
        or value != os.path.basename(value)
        or os.sep in value
        or (os.altsep is not None and os.altsep in value)
        or not value.endswith(".jsonl")
    ):
        fail("Session reads accept only a direct-child .jsonl filename.")
    return value


def open_session(name: str):
    checked_name(name)
    flags = os.O_RDONLY | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(name, flags, dir_fd=directory_fd)
    except OSError as error:
        fail(f"Cannot open session {json.dumps(name)}: {error}")
    try:
        descriptor_stat = os.fstat(descriptor)
        path_stat = os.stat(
            name,
            dir_fd=directory_fd,
            follow_symlinks=False,
        )
        if (
            not stat.S_ISREG(descriptor_stat.st_mode)
            or not stat.S_ISREG(path_stat.st_mode)
            or descriptor_stat.st_nlink != 1
            or descriptor_stat.st_dev != path_stat.st_dev
            or descriptor_stat.st_ino != path_stat.st_ino
            or (
                hasattr(os, "getuid")
                and descriptor_stat.st_uid != os.getuid()
            )
            or (
                os.name != "nt"
                and stat.S_IMODE(descriptor_stat.st_mode) != 0o600
            )
        ):
            fail(
                "Session is not a private, singly-linked direct-child "
                f"regular file: {json.dumps(name)}"
            )
        return os.fdopen(descriptor, "r", encoding="utf-8", errors="strict")
    except BaseException:
        os.close(descriptor)
        raise


def records(name: str) -> Iterator[dict[str, Any]]:
    with open_session(name) as handle:
        line_number = 0
        while True:
            try:
                line = handle.readline()
            except UnicodeDecodeError as error:
                fail(
                    f"Invalid session UTF-8 in {json.dumps(name)} "
                    f"near line {line_number + 1}: {error}"
                )
            if not line:
                break
            line_number += 1
            try:
                value = json.loads(line)
            except json.JSONDecodeError as error:
                fail(
                    f"Invalid session JSONL in {json.dumps(name)} "
                    f"at line {line_number}: {error}"
                )
            if not isinstance(value, dict):
                fail(
                    f"Invalid non-object session event in {json.dumps(name)} "
                    f"at line {line_number}"
                )
            yield value


def text_content(content: Any) -> str:
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return str(content)
    return "".join(
        str(part.get("text", ""))
        for part in content
        if isinstance(part, dict)
    )


def render(name: str) -> None:
    for record in records(name):
        if record.get("type") == "session":
            print(f"=== Session: {record.get('timestamp', '?')} ===")
            print(f"    cwd: {record.get('cwd', '?')}")
            print()
            continue
        if record.get("type") != "message":
            continue
        message = record.get("message")
        if not isinstance(message, dict):
            continue
        role = str(message.get("role", "?"))
        content = message.get("content", "")
        if role == "toolResult":
            tool = message.get("toolName", "?")
            text = text_content(content)
            if len(text) > 500:
                text = f"{text[:500]}... [truncated]"
            print(f"[{tool} result]: {text}\n")
            continue
        if isinstance(content, str):
            print(f"{role}: {content}\n")
            continue
        if not isinstance(content, list):
            continue
        for part in content:
            if not isinstance(part, dict):
                continue
            part_type = part.get("type", "")
            if part_type == "thinking":
                continue
            if part_type == "text":
                text = str(part.get("text", ""))
                if len(text) > 1000:
                    text = f"{text[:1000]}... [truncated]"
                print(f"{role}: {text}\n")
            elif part_type == "toolCall":
                name_value = part.get("name", "?")
                arguments = part.get("arguments", {})
                rendered = json.dumps(arguments, ensure_ascii=True)
                if len(rendered) > 200:
                    rendered = f"{rendered[:200]}..."
                print(f"{role}: [{name_value}] {rendered}\n")


def list_sessions(trace_only: bool) -> None:
    if trace_only and trace_id:
        print(f"Sessions for trace {trace_id}:")
    else:
        print(f"All sessions in {session_dir}:")
    print()
    for entry in session_entries(trace_only):
        messages = 0
        timestamp = "?"
        for index, record in enumerate(records(entry.name)):
            if index == 0:
                timestamp = str(record.get("timestamp", "?"))[:19]
            if record.get("type") == "message":
                messages += 1
        display_name = json.dumps(entry.name, ensure_ascii=True)
        print(
            f"  {display_name:<52} {entry.size:6d} bytes  "
            f"{messages:3d} msgs  {timestamp}"
        )


def grep_sessions(pattern_text: str, trace_only: bool) -> None:
    try:
        pattern = re.compile(pattern_text, re.IGNORECASE)
    except re.error as error:
        fail(f"Invalid regular expression: {error}", 2)
    for entry in session_entries(trace_only):
        matches: list[str] = []
        for record in records(entry.name):
            if record.get("type") != "message":
                continue
            message = record.get("message")
            if not isinstance(message, dict):
                continue
            role = str(message.get("role", "?"))
            content = message.get("content", "")
            if isinstance(content, str):
                if pattern.search(content):
                    matches.append(f"{role}: {content[:150]}")
                continue
            if not isinstance(content, list):
                continue
            for part in content:
                text = part.get("text", "") if isinstance(part, dict) else ""
                if isinstance(text, str) and text and pattern.search(text):
                    matches.append(f"{role}: {text[:150]}")
        if matches:
            print(f"--- {json.dumps(entry.name, ensure_ascii=True)} ---")
            print("\n".join(matches))
            print()


arguments = sys.argv[1:]
command = arguments.pop(0) if arguments else "list"
if command in ("list", "--trace"):
    if arguments:
        fail("Usage: rlm_sessions [list|--trace|read <file>|grep [-t] <pattern>]", 2)
    list_sessions(command == "--trace")
elif command == "read":
    if len(arguments) != 1:
        fail("Usage: rlm_sessions read <file|--last>", 2)
    if arguments[0] == "--last":
        entries = session_entries()
        if not entries:
            fail("No sessions found.")
        selected = max(entries, key=lambda item: item.mtime_ns)
        render(selected.name)
    else:
        render(checked_name(arguments[0]))
elif command == "grep":
    trace_only = bool(arguments and arguments[0] == "-t")
    if trace_only:
        arguments.pop(0)
    if len(arguments) != 1:
        fail("Usage: rlm_sessions grep [-t] <pattern>", 2)
    grep_sessions(arguments[0], trace_only)
else:
    fail("Usage: rlm_sessions [list|--trace|read <file>|grep [-t] <pattern>]", 2)

os.close(directory_fd)
