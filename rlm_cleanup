#!/usr/bin/env bash
# rlm_cleanup — Clean up stale rlm temporary state.
#
# Usage:
#   rlm_cleanup              # dry-run: show what would be cleaned
#   rlm_cleanup --force      # actually delete
#   rlm_cleanup --age 60     # override age threshold (default: 120 min)
#   rlm_cleanup --attempt-age 10080  # attempt-ref threshold (default: 7 days)
#   rlm_cleanup --repo PATH  # repository whose refs should be inspected
#
# What it cleans:
#   1. ${TMPDIR:-/tmp}/rlm_* temp files (context, prompts, cost, async output)
#   2. ${TMPDIR:-/tmp}/rlm_calls_*.counter.lock stale call-counter locks
#   3. ${TMPDIR:-/tmp}/rlm_async_* private job directories
#   4. stale registered ypi implementer worktrees (salvaged before removal)
#   5. ${TMPDIR:-/tmp}/rlm_ws_* legacy workspace directories
#   6. refs/ypi/attempt-* older than the attempt-ref threshold
#
# Safe by default: dry-run unless --force is passed.

set -euo pipefail

FORCE=false
AGE_MIN=120  # minutes
ATTEMPT_AGE_MIN=10080
REPO_PATH="$PWD"
REPO_EXPLICIT=false

while [[ "${1:-}" == --* ]]; do
    case "$1" in
        --force) FORCE=true; shift ;;
        --age) AGE_MIN="$2"; shift 2 ;;
        --attempt-age) ATTEMPT_AGE_MIN="$2"; shift 2 ;;
        --repo) REPO_PATH="$2"; REPO_EXPLICIT=true; shift 2 ;;
        --help|-h)
            sed -n '2,/^$/{ s/^# //; s/^#$//; p }' "$0"
            exit 0
            ;;
        *) echo "Unknown flag: $1" >&2; exit 1 ;;
    esac
done

[[ "$AGE_MIN" =~ ^[0-9]+$ ]] || { echo "--age must be a non-negative integer" >&2; exit 2; }
[[ "$ATTEMPT_AGE_MIN" =~ ^[0-9]+$ ]] || { echo "--attempt-age must be a non-negative integer" >&2; exit 2; }

echo "rlm_cleanup — age threshold: ${AGE_MIN}m, mode: $( $FORCE && echo 'FORCE' || echo 'dry-run' )"
TMP_ROOT="${TMPDIR:-/tmp}"
echo ""

# --- 1. Temp files ---
FILES=$(find "$TMP_ROOT" -maxdepth 1 -name 'rlm_*' ! -type d -mmin +"$AGE_MIN" 2>/dev/null || true)
FILE_COUNT=0
[ -n "$FILES" ] && FILE_COUNT=$(echo "$FILES" | wc -l)
FILE_SIZE="0"
[ -n "$FILES" ] && FILE_SIZE=$(echo "$FILES" | xargs du -ch 2>/dev/null | tail -1 | cut -f1 || echo "0")

echo "Temp files older than ${AGE_MIN}m: $FILE_COUNT ($FILE_SIZE)"
if [ "$FILE_COUNT" -gt 0 ]; then
    if [ "$FORCE" = true ]; then
        echo "$FILES" | xargs rm -f 2>/dev/null
        echo "  ✓ deleted"
    else
        echo "  (use --force to delete)"
    fi
fi

# --- 2. Stale call-counter lock directories ---
LOCK_DIRS=$(find "$TMP_ROOT" -maxdepth 1 -name 'rlm_calls_*.counter.lock' -type d -mmin +"$AGE_MIN" 2>/dev/null || true)
LOCK_COUNT=0
[ -n "$LOCK_DIRS" ] && LOCK_COUNT=$(echo "$LOCK_DIRS" | wc -l)
echo "Call-counter locks older than ${AGE_MIN}m: $LOCK_COUNT"
if [ "$LOCK_COUNT" -gt 0 ]; then
    if [ "$FORCE" = true ]; then
        echo "$LOCK_DIRS" | xargs rm -rf 2>/dev/null
        echo "  ✓ deleted"
    else
        echo "  (use --force to delete)"
    fi
fi

# --- 3. Private async job directories ---
ASYNC_DIRS=$(
    find "$TMP_ROOT" -maxdepth 1 -name 'rlm_async_*' -type d -mmin +"$AGE_MIN" 2>/dev/null | while IFS= read -r candidate; do
        name=$(basename "$candidate")
        if [[ "$name" =~ ^rlm_async_.+[._][A-Za-z0-9]{6}$ ]] \
            && { [ -e "$candidate/output.txt" ] || [ -e "$candidate/job.json" ] || [ -e "$candidate/done" ]; }; then
            printf '%s\n' "$candidate"
        fi
    done
)
ASYNC_COUNT=0
[ -n "$ASYNC_DIRS" ] && ASYNC_COUNT=$(echo "$ASYNC_DIRS" | wc -l)
ASYNC_SIZE="0"
[ -n "$ASYNC_DIRS" ] && ASYNC_SIZE=$(echo "$ASYNC_DIRS" | xargs du -csh 2>/dev/null | tail -1 | cut -f1 || echo "0")

echo "Async job dirs older than ${AGE_MIN}m: $ASYNC_COUNT ($ASYNC_SIZE)"
if [ "$ASYNC_COUNT" -gt 0 ]; then
    if [ "$FORCE" = true ]; then
        echo "$ASYNC_DIRS" | xargs rm -rf 2>/dev/null
        echo "  ✓ deleted"
    else
        echo "  (use --force to delete)"
    fi
fi

clean_git() (
    for key in $(compgen -A variable GIT_ 2>/dev/null || true); do unset "$key"; done
    command git -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
)

# Record recovery state before cleanup. A ref that becomes the sole authoritative
# copy in this invocation must not also be expired later in the same invocation.
IMPLEMENTER_STATE_SEEN=false
PRE_RECOVERY_ROOT=$(clean_git -C "$REPO_PATH" rev-parse --show-toplevel 2>/dev/null || true)
if [ -n "$PRE_RECOVERY_ROOT" ]; then
    PRE_RECOVERY_COMMON=$(clean_git -C "$PRE_RECOVERY_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
    if [ -n "$PRE_RECOVERY_COMMON" ]; then
        PRE_RECOVERY_LOCK="$PRE_RECOVERY_COMMON/ypi-implementers.lock"
        PRE_RECOVERY_LEASES="$PRE_RECOVERY_COMMON/ypi-implementers/leases"
        if [ -e "$PRE_RECOVERY_LOCK" ] || [ -L "$PRE_RECOVERY_LOCK" ] \
            || { [ -d "$PRE_RECOVERY_LEASES" ] && find "$PRE_RECOVERY_LEASES" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; }; then
            IMPLEMENTER_STATE_SEEN=true
        fi
    fi
fi

# --- 4. Registered implementer worktrees ---
IMPLEMENTER_CLEANUP="$(cd "$(dirname "$0")" && pwd)/scripts/cleanup_implementer_workspaces.py"
IMPLEMENTER_ARGS=(--repo "$REPO_PATH" --age "$AGE_MIN")
[ "$FORCE" = true ] && IMPLEMENTER_ARGS+=(--force)
python3 "$IMPLEMENTER_CLEANUP" "${IMPLEMENTER_ARGS[@]}"

# --- 5. Legacy workspace directories ---
# Registered ypi_ws_* directories are recovered through their repository lease
# metadata above. Never delete them from a generic temp-directory sweep.
WS_DIRS=$(find "$TMP_ROOT" -maxdepth 1 -name 'rlm_ws_*' -type d -mmin +"$AGE_MIN" 2>/dev/null || true)
WS_COUNT=0
[ -n "$WS_DIRS" ] && WS_COUNT=$(echo "$WS_DIRS" | wc -l)
WS_SIZE="0"
[ -n "$WS_DIRS" ] && WS_SIZE=$(echo "$WS_DIRS" | xargs du -csh 2>/dev/null | tail -1 | cut -f1 || echo "0")

echo "Workspace dirs older than ${AGE_MIN}m: $WS_COUNT ($WS_SIZE)"
if [ "$WS_COUNT" -gt 0 ]; then
    if [ "$FORCE" = true ]; then
        echo "$WS_DIRS" | xargs rm -rf 2>/dev/null
        echo "  ✓ deleted"
    else
        echo "  (use --force to delete)"
    fi
fi

# --- 6. Aged implementer attempt refs ---
REPO_ROOT=$(clean_git -C "$REPO_PATH" rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$REPO_ROOT" ]; then
    if [ "$REPO_EXPLICIT" = true ]; then
        echo "rlm_cleanup: --repo is not an existing Git checkout: $REPO_PATH" >&2
        exit 2
    fi
    echo "Attempt refs older than ${ATTEMPT_AGE_MIN}m: no Git checkout"
else
    COMMON_GIT_DIR=$(clean_git -C "$REPO_ROOT" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
    IMPLEMENT_LOCK="$COMMON_GIT_DIR/ypi-implementers.lock"
    IMPLEMENT_LEASES="$COMMON_GIT_DIR/ypi-implementers/leases"
    if [ "$IMPLEMENTER_STATE_SEEN" = true ]; then
        echo "Attempt refs older than ${ATTEMPT_AGE_MIN}m: skipped (implementer recovery state existed at command start)"
    elif [ -e "$IMPLEMENT_LOCK" ] || [ -L "$IMPLEMENT_LOCK" ] \
        || { [ -d "$IMPLEMENT_LEASES" ] && find "$IMPLEMENT_LEASES" -mindepth 1 -maxdepth 1 -print -quit | grep -q .; }; then
        echo "Attempt refs older than ${ATTEMPT_AGE_MIN}m: skipped (implementer recovery state is still live)"
    else
        NOW=$(date +%s)
        CUTOFF=$((NOW - ATTEMPT_AGE_MIN * 60))
        ATTEMPT_REFS=$(
            clean_git -C "$REPO_ROOT" for-each-ref \
                --format='%(refname) %(objectname) %(committerdate:unix)' \
                refs/ypi/ 2>/dev/null \
            | while read -r ref oid committed_at; do
                if [[ "$ref" == refs/ypi/attempt-* ]] \
                    && [[ "$committed_at" =~ ^[0-9]+$ ]] \
                    && [ "$committed_at" -le "$CUTOFF" ]; then
                    printf '%s %s\n' "$ref" "$oid"
                fi
            done
        )
        ATTEMPT_COUNT=0
        [ -n "$ATTEMPT_REFS" ] && ATTEMPT_COUNT=$(printf '%s\n' "$ATTEMPT_REFS" | wc -l)
        echo "Attempt refs older than ${ATTEMPT_AGE_MIN}m: $ATTEMPT_COUNT"
        if [ "$ATTEMPT_COUNT" -gt 0 ]; then
            if [ "$FORCE" = true ]; then
                while read -r ref oid; do
                    [ -n "$ref" ] && clean_git -C "$REPO_ROOT" update-ref -d "$ref" "$oid"
                done <<< "$ATTEMPT_REFS"
                echo "  ✓ deleted"
            else
                printf '%s\n' "$ATTEMPT_REFS" | sed 's/ [0-9a-f]*$//' | sed 's/^/  /'
                echo "  (use --force to delete)"
            fi
        fi
    fi
fi

echo ""
echo "Done."
