#!/usr/bin/env bash
# rlm_cleanup - Recover stale, registered implementer workspaces.
#
# Usage:
#   rlm_cleanup              # inspect registered state
#   rlm_cleanup --force      # recover eligible registered workspaces
#   rlm_cleanup --age 60     # override lease age threshold (default: 120 min)
#   rlm_cleanup --attempt-age 10080  # attempt-ref report threshold (default: 7 days)
#   rlm_cleanup --repo PATH  # repository whose leases and refs should be inspected
#
# Generic rlm_* paths and attempt refs are evidence, not deletion authority.
# This command only delegates destructive cleanup to the typed implementer
# recovery service, which validates persisted leases before acting.

set -euo pipefail

FORCE=false
AGE_MIN=120
ATTEMPT_AGE_MIN=10080
REPO_PATH="$PWD"
REPO_EXPLICIT=false

require_value() {
    local flag="$1"
    local value="${2:-}"
    if [ -z "$value" ] || [[ "$value" == --* ]]; then
        echo "$flag requires a value" >&2
        exit 2
    fi
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --force)
            FORCE=true
            shift
            ;;
        --age)
            require_value "$1" "${2:-}"
            AGE_MIN="$2"
            shift 2
            ;;
        --attempt-age)
            require_value "$1" "${2:-}"
            ATTEMPT_AGE_MIN="$2"
            shift 2
            ;;
        --repo)
            require_value "$1" "${2:-}"
            REPO_PATH="$2"
            REPO_EXPLICIT=true
            shift 2
            ;;
        --help|-h)
            sed -n '2,/^$/{ s/^# //; s/^#$//; p }' "$0"
            exit 0
            ;;
        *)
            echo "Unknown flag: $1" >&2
            exit 1
            ;;
    esac
done

[[ "$AGE_MIN" =~ ^[0-9]+$ ]] || { echo "--age must be a non-negative integer" >&2; exit 2; }
[[ "$ATTEMPT_AGE_MIN" =~ ^[0-9]+$ ]] || { echo "--attempt-age must be a non-negative integer" >&2; exit 2; }

clean_git() (
    local key
    while IFS= read -r key; do
        unset "$key"
    done < <(compgen -A variable GIT_ 2>/dev/null || true)
    command git -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
)

echo "rlm_cleanup - age threshold: ${AGE_MIN}m, mode: $( "$FORCE" && echo 'FORCE' || echo 'dry-run' )"
echo "Generic temp, call-counter, async, and legacy workspace paths: preserved (age is not deletion authority)"

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
IMPLEMENTER_CLEANUP="$SCRIPT_DIR/scripts/cleanup-implementer-workspaces.ts"
NODE_BIN="${YPI_NODE_BIN:-node}"
if ! command -v "$NODE_BIN" >/dev/null 2>&1; then
    echo "rlm_cleanup: Node.js >= 22.19 is required for implementer recovery" >&2
    exit 127
fi

REPO_ROOT=$(clean_git -C "$REPO_PATH" rev-parse --show-toplevel 2>/dev/null || true)
if [ -z "$REPO_ROOT" ] && [ "$REPO_EXPLICIT" = true ]; then
    echo "rlm_cleanup: --repo is not an existing Git checkout: $REPO_PATH" >&2
    exit 2
fi

IMPLEMENTER_ARGS=(--repo "$REPO_PATH" --age "$AGE_MIN")
[ "$FORCE" = true ] && IMPLEMENTER_ARGS+=(--force)
"$NODE_BIN" "$IMPLEMENTER_CLEANUP" "${IMPLEMENTER_ARGS[@]}"

if [ -z "$REPO_ROOT" ]; then
    echo "Attempt refs older than ${ATTEMPT_AGE_MIN}m: no Git checkout"
else
    NOW=$(date +%s)
    CUTOFF=$((NOW - ATTEMPT_AGE_MIN * 60))
    ATTEMPT_REFS=$(
        clean_git -C "$REPO_ROOT" for-each-ref \
            --format='%(refname) %(objectname) %(committerdate:unix)' \
            refs/ypi/ 2>/dev/null \
        | while read -r ref oid committed_at; do
            if [[ "$ref" == refs/ypi/attempt-* ]] \
                && [[ "$oid" =~ ^[0-9a-f]+$ ]] \
                && [[ "$committed_at" =~ ^[0-9]+$ ]] \
                && [ "$committed_at" -le "$CUTOFF" ]; then
                printf '%s %s\n' "$ref" "$oid"
            fi
        done
    )
    ATTEMPT_COUNT=0
    [ -n "$ATTEMPT_REFS" ] && ATTEMPT_COUNT=$(printf '%s\n' "$ATTEMPT_REFS" | wc -l)
    echo "Attempt refs older than ${ATTEMPT_AGE_MIN}m: $ATTEMPT_COUNT (preserved)"
    if [ "$ATTEMPT_COUNT" -gt 0 ]; then
        printf '%s\n' "$ATTEMPT_REFS" | while read -r ref _oid; do
            printf '  %s\n' "$ref"
        done
    fi
fi

echo "Done."
